# Configuración del Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cenarepas_db
DB_SCHEMA=cenarepas
# Alternativa a DB_HOST..DB_NAME (la que entrega Render); si existe, tiene prioridad.
# DATABASE_URL=postgresql://usuario:clave@dpg-xxxx-a.oregon-postgres.render.com:5432/cenarepas_staging
# SSL: se activa solo para hosts de Render (dpg-*, *.render.com), con ?sslmode= en
# DATABASE_URL o con NODE_ENV=production. DB_SSL=true/false lo fuerza.
# DB_SSL=

# Seguridad y Autenticación JWT
JWT_SECRET=cenarepas_super_secret_jwt_key_2026_masarepas
JWT_EXPIRES_IN=24h

# Correo (recuperación de contraseña). En Staging y local: CORREO_PROVEEDOR=consola
# (no envía; escribe el código en la consola). En producción (Render): brevo.
# Render gratuito bloquea el SMTP saliente: por eso se usa la API de Brevo.
CORREO_PROVEEDOR=consola
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=CENAREPAS
