# Plantilla de Backend/.env.staging (Staging). Copia este archivo como
# .env.staging y completa los valores; el .env.staging real nunca va al
# repositorio. Arranque: npm run dev:staging (o start:staging).
PORT=4000
NODE_ENV=staging
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cenarepas_staging
DB_SCHEMA=cenarepas
# Alternativa a DB_HOST..DB_NAME (Render); si existe, tiene prioridad.
# DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=24h

# Correo (f): en Staging no se envía; el código se escribe en la consola del servidor.
CORREO_PROVEEDOR=consola

# Imágenes y archivos en Cloudinary (panel de Cloudinary → Dashboard → API Keys).
# Van SOLO aquí y en las variables del servicio del backend en Render; nunca en
# el frontend ni en el repositorio. Las tres juntas: si falta una, no se usa
# Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
